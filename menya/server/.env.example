PORT=4000
MONGODB_URI=mongodb://127.0.0.1:27017/menya
CLIENT_ORIGIN=http://localhost:5173
JWT_ACCESS_SECRET=replace-with-a-long-random-access-secret
JWT_REFRESH_SECRET=replace-with-a-different-long-random-refresh-secret

# AI provider (Gemini is the primary provider; leave AI_API_KEY empty for deterministic fallback)
AI_PROVIDER=gemini
AI_API_KEY=your-free-gemini-api-key
AI_MODEL=gemini-3.1-flash-lite
AI_TEMPERATURE=0.35
AI_MAX_OUTPUT_TOKENS=900
AI_TIMEOUT_MS=30000
AI_CACHE_TTL_MS=600000
AI_DAILY_QUOTA=20
AI_MAX_PROMPT_CHARS=8000
